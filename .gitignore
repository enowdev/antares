# Go
bin/
.air/
*.test
# A cross-compile run drops the binary in the repo root; it once got committed.
# Anchored so it cannot swallow cmd/antares/ source files.
/antares
/antares.exe

# Node
node_modules/
web/dist/
internal/server/dist/*

# Dev-only UI prototypes (not shipped). See web/src/App.tsx SampleRoutes.
web/src/sample/

# Local state
*.db
*.db-wal
*.db-shm
.env
.env.local
# Migration fixtures are fake homes of other agents; their .env files hold fake keys.
!internal/migrate/testdata/**/.env
# OpenHuman keeps its memory in a SQLite file; the fixture needs it present so
# the planner reports the "memory.db is not imported" warning.
!internal/migrate/testdata/**/memory.db
/tuishot

# Local agent/editor tooling (not part of the project)
.agents/
.cursor/
.gemini/
.opencode/
.mcp.json
opencode.json
# Anchored: the migration fixtures are fake homes of other agents and include
# AGENTS.md/CLAUDE.local.md files. An unanchored rule here once kept them out of
# every checkout, so the migrate golden tests failed on CI and nowhere local.
/AGENTS.md
.worktrees/
.superpowers/
.codegraph/

# Release artifacts
dist/
!internal/server/dist/
!internal/server/dist/.gitkeep
web/tsconfig.tsbuildinfo

# Windows resources CI generates for the desktop shell.
desktop/rsrc_windows_*.syso
