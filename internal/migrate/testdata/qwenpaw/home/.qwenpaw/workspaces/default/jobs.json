{
  "version": 2,
  "jobs": [
    {
      "id": "j1",
      "name": "Weekly review",
      "enabled": true,
      "schedule": {
        "type": "cron",
        "cron": "0 18 * * 5",
        "timezone": "Asia/Jakarta"
      },
      "task_type": "agent",
      "request": {
        "input": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Review my week."
              }
            ]
          }
        ]
      },
      "dispatch": {
        "type": "channel",
        "channel": "telegram",
        "target": {
          "user_id": "42",
          "session_id": "s"
        }
      }
    },
    {
      "id": "j2",
      "name": "Hello",
      "enabled": false,
      "schedule": {
        "type": "cron",
